# pyenv
#   For a library or app, you might want to share your .python-version if you're
#   using pyenv. See https://github.com/pyenv/pyenv/blob/master/COMMANDS.md#pyenv-version
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install dependencies that are needed.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains exact versions, but may cause issues
#   if you are collaborating across platforms or with different python versions.
#poetry.lock

# pdm
#   Similar to Poetry and Pipenv, pdm.lock contains exact versions
.pdm-plugins/
pdm.lock

